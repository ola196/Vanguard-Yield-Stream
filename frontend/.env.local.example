# Copy this file to .env.local and fill in the values after running deploy.sh
# ─────────────────────────────────────────────────────────────────────────────

# Soroban contract ID — populated automatically by scripts/deploy.sh
NEXT_PUBLIC_STREAM_CONTRACT_ID=

# Stellar Network passphrase
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban RPC endpoint for Testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Horizon URL for Testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
